@page
@model IncidentCopilot.Pages.IndexModel
@{
    ViewData["Title"] = "Incident Copilot";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; font-family: system-ui, sans-serif; line-height: 1.5; }
        body { background: #f5f7fb; color: #1f2937; margin: 0; }
        main { margin: 0 auto; max-width: 760px; padding: 3rem 1.25rem; }
        .card { background: #fff; border: 1px solid #dbe2ea; border-radius: 12px; padding: 2rem; box-shadow: 0 8px 24px rgb(15 23 42 / 8%); }
        h1, h2 { color: #111827; margin-top: 0; }
        .intro { color: #4b5563; margin-bottom: 2rem; }
        .field { margin-bottom: 1.25rem; }
        label { display: block; font-weight: 650; margin-bottom: .4rem; }
        input, textarea { border: 1px solid #b8c2cf; border-radius: 6px; box-sizing: border-box; font: inherit; padding: .7rem .8rem; width: 100%; }
        textarea { min-height: 7rem; resize: vertical; }
        input:focus, textarea:focus { border-color: #2563eb; outline: 3px solid rgb(37 99 235 / 18%); }
        .hint { color: #6b7280; font-size: .9rem; margin: .3rem 0 0; }
        .validation-summary-errors, .field-validation-error { color: #b42318; font-size: .92rem; }
        .validation-summary-errors { margin-bottom: 1rem; }
        .validation-summary-valid, .field-validation-valid { display: none; }
        button { background: #1d4ed8; border: 0; border-radius: 6px; color: #fff; cursor: pointer; font: inherit; font-weight: 650; padding: .75rem 1.1rem; }
        button:hover { background: #1e40af; }
        .notice { background: #eff6ff; border-left: 4px solid #2563eb; margin-top: 1.5rem; padding: 1rem; }
        .error { background: #fff4f2; border-left: 4px solid #b42318; margin-top: 1.5rem; padding: 1rem; }
        .analysis { border-top: 1px solid #dbe2ea; margin-top: 2rem; padding-top: 1.5rem; }
        .analysis-section { border-top: 1px solid #edf0f4; margin-top: 1.25rem; padding-top: 1.25rem; }
        .analysis-section h3 { color: #1f2937; margin-bottom: .5rem; }
        .analysis-section p { margin-top: 0; white-space: pre-wrap; }
        ul { margin: .5rem 0 0; padding-left: 1.35rem; }
        .warning { color: #7a341e; }
        .loading-overlay { align-items: center; background: rgb(15 23 42 / 52%); display: flex; inset: 0; justify-content: center; padding: 1.25rem; position: fixed; z-index: 1000; }
        .loading-overlay[hidden] { display: none; }
        .loading-dialog { background: #fff; border-radius: 14px; box-shadow: 0 18px 50px rgb(15 23 42 / 28%); max-width: 360px; padding: 2rem; text-align: center; width: 100%; }
        .loading-dialog h2 { margin-bottom: .5rem; }
        .loading-dialog p { color: #4b5563; margin: 0; }
        .loading-spinner { animation: loading-spin .9s linear infinite; border: 4px solid #dbeafe; border-radius: 50%; border-top-color: #2563eb; display: inline-block; height: 42px; margin-bottom: 1rem; width: 42px; }
        .loading-progress { background: #dbeafe; border-radius: 999px; height: 6px; margin: 1.25rem 0 .75rem; overflow: hidden; }
        .loading-progress span { animation: loading-progress 1.4s ease-in-out infinite; background: #2563eb; border-radius: inherit; display: block; height: 100%; width: 38%; }
        .loading-hint { font-size: .9rem; }
        @@keyframes loading-spin { to { transform: rotate(360deg); } }
        @@keyframes loading-progress { 0% { transform: translateX(-120%); } 50% { transform: translateX(170%); } 100% { transform: translateX(300%); } }
        @@media (prefers-reduced-motion: reduce) { .loading-spinner, .loading-progress span { animation: none; } }
    </style>
</head>
<body>
    <main>
        <section class="card" aria-labelledby="page-title">
            <h1 id="page-title">Incident Copilot</h1>
            <p class="intro">Organiza la evidencia de un incidente técnico sintético para preparar su análisis.</p>

            <form id="incident-form" method="post">
                <div asp-validation-summary="ModelOnly" role="alert"></div>

                <div class="field">
                    <label asp-for="Input.Title">Título</label>
                    <input asp-for="Input.Title" maxlength="@IncidentRequest.MaxTitleLength" autocomplete="off" />
                    <span asp-validation-for="Input.Title"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Symptoms">Síntomas</label>
                    <textarea asp-for="Input.Symptoms" maxlength="@IncidentRequest.MaxSymptomsLength"></textarea>
                    <span asp-validation-for="Input.Symptoms"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.TechnicalContext">Contexto técnico</label>
                    <textarea asp-for="Input.TechnicalContext" maxlength="@IncidentRequest.MaxTechnicalContextLength"></textarea>
                    <p class="hint">Opcional. Incluye componentes, entorno o cambios recientes relevantes.</p>
                    <span asp-validation-for="Input.TechnicalContext"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Logs">Logs / contexto técnico adicional</label>
                    <textarea asp-for="Input.Logs" maxlength="@IncidentRequest.MaxLogsLength"></textarea>
                    <p class="hint">Opcional. Usa únicamente datos sintéticos y evita credenciales.</p>
                    <span asp-validation-for="Input.Logs"></span>
                </div>

                <button id="analyze-button" type="submit">Analizar incidente</button>
            </form>

            @if (Model.AnalysisError is not null)
            {
                <section class="error" aria-live="assertive" role="alert">
                    <h2>No se pudo completar el análisis</h2>
                    <p>@Model.AnalysisError.UserMessage</p>
                    @if (Model.AnalysisError.CanRetry)
                    {
                        <p> Puedes volver a intentarlo más tarde.</p>
                    }
                </section>
            }

            @if (Model.Analysis is not null)
            {
                <section class="analysis" aria-labelledby="analysis-title" aria-live="polite">
                    <h2 id="analysis-title">Resultado del análisis</h2>
                    <p class="notice">Las posibles causas son hipótesis basadas en la evidencia suministrada; deben comprobarse antes de realizar cambios.</p>

                    <section class="analysis-section" aria-labelledby="summary-title">
                        <h3 id="summary-title">Resumen</h3>
                        <p>@Model.Analysis.Summary</p>
                    </section>

                    <section class="analysis-section" aria-labelledby="causes-title">
                        <h3 id="causes-title">Posibles causas</h3>
                        <ul>
                            @foreach (var cause in Model.Analysis.PossibleCauses ?? Enumerable.Empty<string>())
                            {
                                <li>@cause</li>
                            }
                        </ul>
                    </section>

                    <section class="analysis-section" aria-labelledby="checks-title">
                        <h3 id="checks-title">Comprobaciones sugeridas</h3>
                        <ul>
                            @foreach (var check in Model.Analysis.SuggestedChecks ?? Enumerable.Empty<string>())
                            {
                                <li>@check</li>
                            }
                        </ul>
                    </section>

                    <section class="analysis-section" aria-labelledby="steps-title">
                        <h3 id="steps-title">Próximos pasos</h3>
                        <ul>
                            @foreach (var step in Model.Analysis.NextSteps ?? Enumerable.Empty<string>())
                            {
                                <li>@step</li>
                            }
                        </ul>
                    </section>

                    <section class="analysis-section" aria-labelledby="warnings-title">
                        <h3 id="warnings-title">Advertencias</h3>
                        @if (Model.Analysis.Warnings is { Count: > 0 })
                        {
                            <ul class="warning">
                                @foreach (var warning in Model.Analysis.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No se registraron advertencias adicionales.</p>
                        }
                    </section>
                </section>
            }
        </section>
    </main>

    <div id="analysis-loading" class="loading-overlay" hidden aria-hidden="true">
        <section class="loading-dialog" role="alertdialog" aria-modal="true" aria-labelledby="loading-title" aria-describedby="loading-description">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2 id="loading-title">Analizando incidente</h2>
            <p id="loading-description">Estamos consultando el proveedor y preparando las hipótesis.</p>
            <div class="loading-progress" aria-hidden="true"><span></span></div>
            <p class="loading-hint">No cierres ni actualices esta ventana.</p>
        </section>
    </div>

    <script>
        (() => {
            const form = document.getElementById('incident-form');
            const loading = document.getElementById('analysis-loading');
            const submitButton = document.getElementById('analyze-button');

            if (!form || !loading || !submitButton) {
                return;
            }

            form.addEventListener('submit', (event) => {
                if (!form.checkValidity()) {
                    return;
                }

                loading.hidden = false;
                loading.setAttribute('aria-hidden', 'false');
                form.setAttribute('aria-busy', 'true');
                submitButton.disabled = true;
                submitButton.textContent = 'Analizando...';
            });

            window.addEventListener('pageshow', () => {
                loading.hidden = true;
                loading.setAttribute('aria-hidden', 'true');
                form.removeAttribute('aria-busy');
                submitButton.disabled = false;
                submitButton.textContent = 'Analizar incidente';
            });
        })();
    </script>
</body>
</html>
